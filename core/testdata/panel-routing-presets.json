[
  {
    "id": "custom",
    "label": "自定义原生配置",
    "description": "编辑 sing-box 1.14.3 的 route、dns、outbounds。direct 出口与本地 DNS 默认提供。",
    "config": {"route": {"rules": []}}
  },
  {
    "id": "domain-block",
    "label": "阻断指定域名",
    "description": "把 example.com 改为需要阻断的域名后缀；包含子域名。",
    "config": {"route": {"rules": [{"action": "sniff"}, {"domain_suffix": ["example.com"], "action": "reject"}]}}
  },
  {
    "id": "ip-block",
    "label": "阻断 IP / 网段",
    "description": "把示例网段改为实际 CIDR；先解析域名，再按目标 IP 匹配。",
    "config": {"route": {"rules": [{"action": "resolve"}, {"ip_cidr": ["192.0.2.0/24"], "action": "reject"}]}}
  },
  {
    "id": "domain-proxy",
    "label": "指定域名走代理出口",
    "description": "修改域名、SOCKS 服务器及端口。出口标签 proxy 必须与规则引用一致。",
    "config": {"route": {"rules": [{"action": "sniff"}, {"domain_suffix": ["example.com"], "action": "route", "outbound": "proxy"}]}, "outbounds": [{"type": "socks", "tag": "proxy", "server": "proxy.example.com", "server_port": 1080}]}
  },
  {
    "id": "dns-split",
    "label": "指定域名使用 HTTPS DNS",
    "description": "使用新版 typed DNS server。修改匹配域名及解析服务器，其他域名使用本地 DNS。",
    "config": {"dns": {"servers": [{"type": "local", "tag": "local"}, {"type": "https", "tag": "doh", "server": "1.1.1.1", "server_port": 443, "path": "/dns-query", "tls": {"server_name": "cloudflare-dns.com"}}], "rules": [{"domain_suffix": ["example.com"], "action": "route", "server": "doh"}], "final": "local"}, "route": {"rules": [{"action": "sniff"}, {"action": "resolve"}]}}
  },
  {
    "id": "remote-rule-set",
    "label": "使用远程规则集",
    "description": "将示例 URL 替换为可访问的 HTTPS .srs 文件；不再使用 geosite / geoip 数据库。",
    "config": {"route": {"rule_set": [{"type": "remote", "tag": "remote-rules", "format": "binary", "url": "https://example.com/rules.srs", "download_detour": "direct", "update_interval": "1d"}], "rules": [{"rule_set": ["remote-rules"], "action": "reject"}]}}
  }
]
